# Argus Mobile environment configuration.
# Copy to .env for local development. Never commit .env.
# Backend API base (API Gateway HTTP API, stage $default, base path /v1).
# When unset, the app runs on offline mock data with a MOCK DATA badge
# for read-only views; write operations report that the API is unconfigured.
VITE_API_BASE=
# Amazon Location Service API key for MapLibre vector tiles.
# When unset, the map falls back to OpenStreetMap raster tiles.
VITE_LOCATION_API_KEY=
VITE_AWS_REGION=us-east-1
